<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Template name="SettingsPanel" src="SettingsPanel.uxml" />
  <Style src="Theme.uss" />
  <ui:VisualElement name="root" class="screen screen--dim">
    <ui:VisualElement class="panel">
      <ui:Label text="PAUSED" class="title" />
      <ui:Label text="THE DUCTS ARE QUIET. FOR NOW." class="subtitle" />
      <ui:Button name="resume" text="RESUME" class="menu-button" />
      <ui:Button name="restart" text="RESTART" class="menu-button" />
      <ui:Button name="settings-toggle" text="SETTINGS" class="menu-button" />
      <ui:Button name="menu" text="MAIN MENU" class="menu-button" />
      <ui:Instance template="SettingsPanel" name="settings-panel" class="hidden" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
